{
  "cli": {
    "version": ">= 8.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "production": {
      "channel": "production",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}
