# App
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/brocolis

# Redis
REDIS_URL=redis://localhost:16379

# Auth
BETTER_AUTH_SECRET=<trocar_obrigatoriamente>
BETTER_AUTH_URL=http://localhost:4000

# Storage (dev/test: MinIO local; staging/prod: Supabase Storage)
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=brocolis
MINIO_SECRET_KEY=brocolis-minio
MINIO_BUCKET=brocolis-documents
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brocolis-documents

# Market (referência)
BROCOLIS_MARKET=AO
BROCOLIS_LOCALE=pt-AO
BROCOLIS_CURRENCY=AOA

# FinPay (adapter)
FINPAY_MODE=mock
FINPAY_API_URL=https://api.finpay.ao
FINPAY_API_KEY=
FINPAY_WEBHOOK_SECRET=

# Mobile (EAS)
EXPO_PUBLIC_API_URL=http://localhost:4000

# ─── F7: Observabilidade (OpenTelemetry) — ver docs/runbooks/observability.md ───
# OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=brocolis-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Prod: 0.1 (head sampling 10%); dev: 1
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token-apm>

# ─── F7: Sentry (erros/performance API+Web+Mobile) ───
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Só CI (upload de sourcemaps): NÃO é DSN, é token de auth
# SENTRY_AUTH_TOKEN=

# ─── F7: Rate limiting (@nestjs/throttler v6 + Redis storage) ───
# THROTTLER_TTL_MS=60000
# THROTTLER_LIMIT=100

# ─── F7: EAS / Mobile release — ver docs/runbooks/eas-release.md ───
# EAS_PROJECT_ID=
# EAS_CHANNEL=development
# EXPO_TOKEN=<só em CI>