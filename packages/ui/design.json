{
  "color": {
    "brand": {
      "50": {
        "$type": "color",
        "$value": "oklch(0.97 0.015 152)",
        "description": "Verde Brócolis mais claro"
      },
      "100": { "$type": "color", "$value": "oklch(0.93 0.04 152)" },
      "200": { "$type": "color", "$value": "oklch(0.87 0.07 152)" },
      "300": { "$type": "color", "$value": "oklch(0.78 0.11 152)" },
      "400": { "$type": "color", "$value": "oklch(0.68 0.13 152)" },
      "500": { "$type": "color", "$value": "oklch(0.55 0.15 152)" },
      "600": { "$type": "color", "$value": "oklch(0.48 0.13 152)" },
      "700": { "$type": "color", "$value": "oklch(0.41 0.11 152)" },
      "800": { "$type": "color", "$value": "oklch(0.35 0.09 152)" },
      "900": { "$type": "color", "$value": "oklch(0.28 0.07 152)" },
      "primary": {
        "$type": "color",
        "$value": "{color.brand.500}",
        "description": "Cor de marca (verde Brócolis)"
      }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "oklch(1 0 0)" },
      "100": { "$type": "color", "$value": "oklch(0.97 0 0)" },
      "200": { "$type": "color", "$value": "oklch(0.922 0 0)" },
      "400": { "$type": "color", "$value": "oklch(0.708 0 0)" },
      "600": { "$type": "color", "$value": "oklch(0.556 0 0)" },
      "800": { "$type": "color", "$value": "oklch(0.269 0 0)" },
      "900": { "$type": "color", "$value": "oklch(0.205 0 0)" },
      "950": { "$type": "color", "$value": "oklch(0.145 0 0)" }
    },
    "action": {
      "primary": {
        "bg": {
          "$type": "color",
          "$value": "{color.brand.primary}",
          "description": "Fundo de CTAs primários"
        },
        "hover": { "$type": "color", "$value": "{color.brand.600}" },
        "foreground": { "$type": "color", "$value": "oklch(0.985 0 0)" }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{color.neutral.100}" },
        "foreground": { "$type": "color", "$value": "{color.neutral.900}" }
      },
      "destructive": {
        "bg": { "$type": "color", "$value": "oklch(0.577 0.245 27.325)" },
        "foreground": { "$type": "color", "$value": "oklch(0.985 0 0)" }
      },
      "ghost": {
        "hover": { "$type": "color", "$value": "{color.neutral.100}" }
      },
      "link": {
        "fg": { "$type": "color", "$value": "{color.brand.600}" }
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "oklch(0.6 0.13 152)",
        "description": "Em stock, verificado, pago"
      },
      "warning": {
        "$type": "color",
        "$value": "oklch(0.79 0.15 80)",
        "description": "Stock baixo, a expirar"
      },
      "danger": {
        "$type": "color",
        "$value": "oklch(0.577 0.245 27.325)",
        "description": "Erro, bloqueado, recusado"
      },
      "info": {
        "$type": "color",
        "$value": "oklch(0.55 0.12 240)",
        "description": "Informação neutra"
      },
      "neutral": { "$type": "color", "$value": "{color.neutral.400}" }
    },
    "surface": {
      "background": { "$type": "color", "$value": "{color.neutral.0}" },
      "card": { "$type": "color", "$value": "{color.neutral.0}" },
      "popover": { "$type": "color", "$value": "{color.neutral.0}" },
      "muted": { "$type": "color", "$value": "{color.neutral.100}" },
      "sidebar": { "$type": "color", "$value": "oklch(0.985 0 0)" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.950}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.800}" },
      "muted": { "$type": "color", "$value": "{color.neutral.600}" },
      "on-primary": {
        "$type": "color",
        "$value": "{color.action.primary.foreground}"
      }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.200}" },
      "input": { "$type": "color", "$value": "{color.neutral.200}" },
      "focus": { "$type": "color", "$value": "{color.brand.400}" }
    },
    "chart": {
      "1": { "$type": "color", "$value": "oklch(0.646 0.222 41.116)" },
      "2": { "$type": "color", "$value": "oklch(0.6 0.118 184.704)" },
      "3": { "$type": "color", "$value": "oklch(0.398 0.07 227.392)" },
      "4": { "$type": "color", "$value": "oklch(0.828 0.189 84.429)" },
      "5": { "$type": "color", "$value": "oklch(0.769 0.188 70.08)" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.375rem" },
    "md": { "$type": "dimension", "$value": "0.5rem" },
    "lg": { "$type": "dimension", "$value": "0.625rem" },
    "xl": { "$type": "dimension", "$value": "0.75rem" },
    "2xl": { "$type": "dimension", "$value": "1rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "md": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1)" },
    "lg": { "$type": "shadow", "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1)" },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 3px oklch(0.68 0.13 152 / 0.3)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "base": { "$type": "duration", "$value": "250ms" },
      "slow": { "$type": "duration", "$value": "400ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "emphasis": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
    }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" },
    "2xl": { "$type": "dimension", "$value": "1536px" }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "string",
        "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
      }
    }
  },
  "components": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{color.action.primary.bg}" },
        "hover": { "$type": "color", "$value": "{color.action.primary.hover}" },
        "foreground": {
          "$type": "color",
          "$value": "{color.action.primary.foreground}"
        }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{color.action.secondary.bg}" }
      },
      "destructive": {
        "bg": { "$type": "color", "$value": "{color.action.destructive.bg}" }
      },
      "ghost": {
        "hover": { "$type": "color", "$value": "{color.action.ghost.hover}" }
      }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{color.surface.card}" },
      "border": { "$type": "color", "$value": "{color.border.default}" }
    },
    "input": {
      "bg": { "$type": "color", "$value": "{color.surface.background}" },
      "border": { "$type": "color", "$value": "{color.border.input}" },
      "focus": {
        "border": { "$type": "color", "$value": "{color.border.focus}" }
      }
    },
    "skeleton": {
      "bg": { "$type": "color", "$value": "{color.surface.muted}" }
    },
    "badge": {
      "success": {
        "bg": { "$type": "color", "$value": "{color.status.success}" }
      }
    },
    "tabs": {
      "active": {
        "bg": { "$type": "color", "$value": "{color.surface.background}" }
      }
    },
    "dialog": {
      "overlay": { "$type": "color", "$value": "oklch(0 0 0 / 0.5)" }
    }
  }
}
